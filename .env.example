# Database
DATABASE_URL=postgres://caisseflow:caisseflow_dev@postgres:5432/caisseflow

# App origin (redirects, CSRF host check in production behind the proxy)
APP_ORIGIN=http://localhost:3000

# Environnement Next.js (development en dev, production en prod)
NODE_ENV=development

# --- Prod uniquement (jamais commité — .env.prod ou secrets Docker/Dokploy) ---
# POSTGRES_PASSWORD=<mot de passe fort>
# POSTGRES_PASSWORD_DEV interdit en prod
# Clés de signature des scellés Z (Keystore côté tablette, clé serveur ici) :
# FISC_SEAL_KEY=<clé générée en prod>
# SMTP (dev : MailHog, prod : relais SMTP réel)
# SMTP_URL=smtp://mailhog:1025
